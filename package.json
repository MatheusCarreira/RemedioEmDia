{
  "name": "remedio-em-dia",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.17",
    "expo-device": "~57.0.1",
    "expo-file-system": "~57.0.6",
    "expo-image": "~57.0.3",
    "expo-image-picker": "~57.0.14",
    "expo-notifications": "~57.0.15",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-task-manager": "~57.0.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "tipos": "tsc --noEmit",
    "estoque:conferir": "node --import ./scripts/registrar-ts.mjs --no-warnings src/dominio/conferir-estoque.ts",
    "lembretes:conferir": "node --import ./scripts/registrar-ts.mjs --no-warnings src/dados/conferir-lembretes.ts",
    "conferir": "npm run tipos && npm run doses:conferir && npm run estoque:conferir && npm run lembretes:conferir",
    "doses:conferir": "node --import ./scripts/registrar-ts.mjs --no-warnings src/dominio/conferir-doses.ts"
  },
  "private": true
}
