{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Os conferidores (`npm run conferir`) rodam no Node, não no aparelho, e
    // usam o SQLite embutido dele. Sem isto o `node:sqlite` não é reconhecido.
    // Não afeta o aplicativo: `types` controla só os tipos GLOBAIS incluídos
    // automaticamente; os tipos do React continuam vindo pelos imports.
    "types": ["node"]
  }
}
